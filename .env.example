# Copy to .env. Do not commit secrets.
#
# Production build (npm run build): variables can also be set in CI.
# Local `npm start` uses src/environments/environment.ts — not this file.

# API URL for production:
# - leave /api if the host proxies /api to the backend
# - or set a full URL: https://<backend>/api
NG_APP_API_URL=/api

# Super Admin like the online-school local login. Production keeps this false
# and uses the backend hardcoded account (superadmin@nimmda.local).
# ENABLE_LOCAL_SUPER_ADMIN=false
# SUPER_ADMIN_EMAIL=superadmin@nimmda.local
# SUPER_ADMIN_PASSWORD=SuperAdmin!ChangeMe
