{
  "buildCommand": "npm run build",
  "outputDirectory": "dist/vercel-static",
  "functions": {
    "api/page.mjs": {
      "includeFiles": "dist/nimmda-frontend/**",
      "maxDuration": 30
    }
  },
  "routes": [
    { "src": "^/sitemap\\.xml$", "dest": "/api/page?p=/sitemap.xml" },
    { "src": "^/(?!api(?:/|$))((?:[^.]*))$", "dest": "/api/page?p=/$1" },
    { "handle": "filesystem" }
  ]
}
