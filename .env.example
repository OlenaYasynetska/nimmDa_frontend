# Copy to .env. Do not commit secrets.
#
# Production build (npm run build): variables can also be set in CI.
# Local `npm start` uses src/environments/environment.ts — not this file.

# API URL for the website production build (`npm run build`).
# The public site does not proxy /api, so the default is the Java API.
#   Production backend:      https://api.nimmda.org/api
#   Android emulator:        npm run build:mobile:emulator
#                            (http://10.0.2.2:8080/api — emulator alias for this PC)
#   Phone on the same Wi-Fi: NG_APP_API_URL=http://<this-PC-LAN-IP>:8080/api
NG_APP_API_URL=https://api.nimmda.org/api

# GA4 measurement ID (NimmDa web stream). Override to use another property.
NG_APP_GA_MEASUREMENT_ID=G-JL2HHG2SKY

# Google AdSense publisher id. The ad script is not in index.html.
# It loads only on listing pages that have content, after a slot id is set and the visitor allows ad cookies.
NG_APP_ADSENSE_CLIENT=ca-pub-7335564704542106
NG_APP_ADSENSE_SLOT=
